# ─── Precast Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Mastra API (agents + Studio playground) ───────────────────────────────────
MASTRA_PORT=4111
MASTRA_HOST=0.0.0.0
# Agent memory store: local SQLite file by default; libsql://... or Postgres in prod.
MASTRA_DB_URL=file:./mastra.db

# ── Web ──────────────────────────────────────────────────────────────────────
WEB_PORT=3000
WEB_HOST=0.0.0.0

# ── LLM provider ───────────────────────────────────────────────────────────────
# Mastra's model gateway reads the key matching the agent's provider/model.
# Default agent uses google/gemini-2.5-flash, so set:
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/precast_dev

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Keycloak ─────────────────────────────────────────────────────────────────
# Keycloak admin credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak client config
KEYCLOAK_TOKEN_ISSUER_URI=http://localhost:8080/realms/precast
KEYCLOAK_CLIENT_ID=precast-api
KEYCLOAK_CLIENT_SECRET=

# ── AgentBase (A2A registry/proxy) ─────────────────────────────────────────────
# All Next ↔ Mastra communication routes through AgentBase's A2A proxy.
AGENTBASE_URL=https://agentbase.example.com
# Bearer token for AgentBase authentication (optional; off when unset).
AGENTBASE_TOKEN=

# ── Mastra API auth ────────────────────────────────────────────────────────────
# Static bearer token protecting the agent API routes (/api/a2a/* and
# /api/agents/*). Clients interact with the agents over the A2A protocol
# (JSON-RPC 2.0) by sending:
#     Authorization: Bearer <AGENT_API_TOKEN>
# The bearer value MUST match this variable. AgentBase injects it when proxying;
# external A2A clients can call the agents directly with it. Off when unset —
# no auth (open for local dev). Studio (/) and agent-card discovery stay open.
AGENT_API_TOKEN=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug