# ─── Precast Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env.
# ONE root .env for the whole monorepo: the dev scripts and `pnpm poc` load it,
# and in production the real environment supplies the values (AgentBase →
# Variables for an imported project).

# ── Mastra API (agents + Studio playground) ──────────────────────────────────
MASTRA_PORT=45000
# This computer only. The image AgentBase builds listens on all addresses itself.
MASTRA_HOST=127.0.0.1
# Agent memory lives in DATABASE_URL below; set MASTRA_DB_URL only to put it on
# a separate Postgres instance.
# MASTRA_DB_URL=postgresql://user:password@your-postgres-host:5432/your_db?sslmode=require
# Mastra's tables go in a schema named after the project (<project>_agents);
# set MASTRA_DB_SCHEMA only to choose another.
# MASTRA_DB_SCHEMA=

# ── Web ──────────────────────────────────────────────────────────────────────
WEB_PORT=45001
WEB_HOST=127.0.0.1

# ── AgentBase ────────────────────────────────────────────────────────────────
# ONE Application authenticates everything this project uses from AgentBase:
# models, MCP servers and the A2A proxy. From Studio → Applications → the app →
# Credentials: Client ID, the secret (shown masked; Copy secret), and the token
# URL (first line of Copy snippet). The apps mint short-lived tokens from these;
# never paste a token here.
AGENTBASE_CLIENT_ID=
AGENTBASE_CLIENT_SECRET=
AGENTBASE_TOKEN_URL=https://keycloak.example.com/realms/agentbase/protocol/openid-connect/token
# The AgentBase API base (the API, not Studio). Agent discovery, the model
# gateway route and MCP subscriptions are all derived from it.
AGENTBASE_URL=https://api.agentbase.example.com

# ── Model ────────────────────────────────────────────────────────────────────
# Models come from your organisation's AgentBase gateway, so no vendor key is
# needed here. Name one the Application is subscribed to (a slug from
# `agentbase.list_models`, or provider/model as onboarded), e.g.
# anthropic/claude-sonnet-5. Once AgentBase hosts the project, an org admin
# sets the model per agent in Studio and that choice wins over this value.
AGENTBASE_LLM_MODEL=

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED, and always Postgres (ADR-002), never run on this computer. `pnpm
# db:provision` asks the database agent on AgentBase for one and writes it here.
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/your_db?sslmode=require

# ── Redis (remote / managed) ─────────────────────────────────────────────────
REDIS_URL=rediss://default:password@your-redis-host:6379

# ── Web → agents transport ───────────────────────────────────────────────────
# Development switch. 1 = the web app calls the local agents app directly
# (before the project is imported), and `pnpm poc` runs both apps. 0 = through
# the AgentBase proxy, which is how it runs once imported; `pnpm poc` then runs
# only the web app (`pnpm poc agents` still starts the local one for Studio).
PRECAST_LOCAL_AGENTS=1
# Where the local agents app answers.
MASTRA_INTERNAL_URL=http://localhost:45000

# ── Mastra API auth ──────────────────────────────────────────────────────────
# Bearer every A2A client must send to /api/a2a/* and /api/agents/*. AgentBase
# injects it when proxying; unset = open, for local development only.
AGENT_API_TOKEN=

# ── Sign-in ──────────────────────────────────────────────────────────────────
# People sign in to the web app before they can chat (Better Auth, accounts in
# this project's Postgres). `pnpm poc` creates BETTER_AUTH_SECRET when it is
# missing; BETTER_AUTH_URL is the address people open the app at.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:45001
# Optional: also let people sign in with an organisation's identity provider.
# OIDC_ISSUER_URI=https://login.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# How many messages one person may send (defaults 20 a minute, 500 a day).
# CHAT_TURNS_PER_MINUTE=20
# CHAT_TURNS_PER_DAY=500

# ── Telemetry ────────────────────────────────────────────────────────────────
# Traces, metrics and logs go to AgentBase's governed telemetry endpoint. A
# project AgentBase hosts needs nothing here: AgentBase injects the endpoint, a
# managed key and the resource attributes at deploy. A project you host yourself
# reports with these two, using a key issued in Studio (the agent's page,
# Telemetry, Issue key; valid 1 to 90 days). Unset, the agents export nothing
# and only carry the trace context through. Mastra's own usage analytics are
# off (MASTRA_TELEMETRY_DISABLED=1 in the image and the agents scripts).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.agentbase.example.com/telemetry/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<key issued in Studio>

# ── Logging ──────────────────────────────────────────────────────────────────
# fatal · error · warn · info · debug · trace. `pnpm dev:verbose` forces debug.
LOG_LEVEL=info
