# ─── Precast Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# SINGLE ROOT .env: this is the ONLY .env file in the monorepo — do NOT create
# per-app .env files in apps/agents or apps/web. The dev/start scripts load this
# root .env (via dotenv-cli); Docker Compose loads it via `env_file: ../.env`;
# in production the real environment supplies the vars.

# ── Mastra API (agents + Studio playground) ───────────────────────────────────
MASTRA_PORT=45000
MASTRA_HOST=0.0.0.0
# Agent memory store (threads, messages, working memory). Postgres, like
# everything else — see ADR-002. OPTIONAL: leave it unset and it falls back to
# DATABASE_URL below, so one provisioned Postgres is enough to boot. Set it
# only to put agent memory on a separate instance from your app data.
# MASTRA_DB_URL=postgresql://user:password@your-postgres-host:5432/your_db?sslmode=require
# Postgres schema Mastra creates its own tables in — keeps them from colliding
# with your application tables when both URLs point at the same database.
MASTRA_DB_SCHEMA=mastra

# ── Web ──────────────────────────────────────────────────────────────────────
WEB_PORT=45001
WEB_HOST=0.0.0.0

# ── Docker published host ports ───────────────────────────────────────────────
# Which HOST ports the app containers are published on (container ports stay
# MASTRA_PORT/WEB_PORT). Default to the same number; override to remap without
# touching the containers — e.g. AGENTS_HOST_PORT=60000, WEB_HOST_PORT=60001
# publishes agents on 60000 and web on 60001. Only affects `pnpm docker:up`.
AGENTS_HOST_PORT=45000
WEB_HOST_PORT=45001

# ── LLM provider ───────────────────────────────────────────────────────────────
# No provider is hardcoded as "the" default. Set ONE key below — the placeholder
# agents auto-detect from whichever is present and use that provider's default
# model. They're checked top to bottom (direct providers before routers); that
# order is an arbitrary tie-break for when several are set, not a
# recommendation. See apps/agents/src/mastra/lib/default-model.ts, which owns
# the canonical list and each provider's default model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=      # or GOOGLE_API_KEY — either is accepted
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
PERPLEXITY_API_KEY=
# Routers / aggregators — one key, many vendors' models behind it.
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=                # Vercel AI Gateway
# Optional: override the auto-detected model with an explicit
# "<provider>/<model>" string (wins over auto-detect regardless of which keys
# above are set), e.g. DEFAULT_LLM_MODEL=anthropic/claude-opus-5
# This is also how you use a provider NOT listed above — Mastra resolves 100+
# community providers by the same string form (e.g. together/…, fireworks/…),
# they just aren't auto-detected. Router models keep their vendor prefix:
# e.g. DEFAULT_LLM_MODEL=openrouter/anthropic/claude-opus-5
DEFAULT_LLM_MODEL=

# ── Database ───────────────────────────────────────────────────────────────
# REQUIRED, and always Postgres (postgres:// or postgresql://) — see ADR-002.
# A provisioned Postgres is a precondition of bootstrapping a Precast project:
# there is no SQLite path and no local-file fallback, so nothing silently
# degrades to a throwaway file that vanishes on the next container rebuild.
#
# Precast still does NOT run Postgres in Compose — point this at a managed
# instance (Neon, Supabase, RDS, Railway, …) and use an SSL URL in production.
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/your_db?sslmode=require

# ── Redis (remote / managed) ─────────────────────────────────────────────────
# Precast does NOT run Redis locally — point this at a managed service
# (e.g. Upstash, Redis Cloud, ElastiCache). `rediss://` = TLS.
REDIS_URL=rediss://default:password@your-redis-host:6379

# ── Keycloak / OIDC ───────────────────────────────────────────────────────────
# Keycloak runs LOCALLY in Docker Compose for dev (unlike Postgres/Redis).
# Admin console: http://localhost:${KEYCLOAK_HOST_PORT} (creds below).
# Issuer URI: in-cluster the apps reach it at http://keycloak:8080/realms/<realm>;
# from the host it's http://localhost:${KEYCLOAK_HOST_PORT}/realms/<realm>. In
# production, point this at a managed Keycloak instead of the local container.
KEYCLOAK_TOKEN_ISSUER_URI=http://localhost:45002/realms/precast
KEYCLOAK_CLIENT_ID=precast-api
KEYCLOAK_CLIENT_SECRET=
# Bootstrap admin for the local Compose Keycloak (dev only — change/remove for prod).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Host port the local Keycloak container is published on (container stays 8080).
KEYCLOAK_HOST_PORT=45002

# ── Docker Compose: which services to build/run ──────────────────────────────
# Toggle which of the three app-stack services `pnpm docker:up` (and friends)
# build/start. Useful once agents/web/keycloak are deployed to DIFFERENT
# places — e.g. Mastra agents imported/hosted by AgentBase, but this compose
# stack still needs to run the Next.js web app + Keycloak somewhere with real
# compute. Comma-separated; no spaces. Default = everything (today's behavior).
#   COMPOSE_PROFILES=agents,web,keycloak   # full local stack (default)
#   COMPOSE_PROFILES=web,keycloak          # agents hosted elsewhere (e.g. AgentBase import)
#   COMPOSE_PROFILES=web                   # web only (Keycloak remote/managed too)
# This is Docker Compose's OWN variable (docs.docker.com/compose/how-tos/profiles) —
# no Precast-specific code reads it. If you exclude `agents`, also point the web
# app's transport at the real agents endpoint (ENABLE_AGENTBASE=1 + the
# AGENTBASE_AGENT_URL_* vars below, or MASTRA_INTERNAL_URL) — it will no longer
# resolve the local `agents` container.
COMPOSE_PROFILES=agents,web,keycloak

# ── Mastra base URL (for direct A2A) ───────────────────────────────────────────
# The web app calls this Mastra base directly when AgentBase is disabled.
# Docker sets it to http://agents:4111 (Docker DNS name).
MASTRA_INTERNAL_URL=http://localhost:45000

# ── AgentBase (A2A registry/proxy) ─────────────────────────────────────────────
# AgentBase is the DEFAULT transport (guard rail): the web app proxies A2A calls
# through AgentBase unless you explicitly set ENABLE_AGENTBASE=0.
#   ENABLE_AGENTBASE=1 (or unset) → proxy through AgentBase (set the vars below).
#   ENABLE_AGENTBASE=0            → talk to Mastra DIRECTLY over A2A
#                                   (POST $MASTRA_INTERNAL_URL/api/a2a/:agentId,
#                                    auth: Bearer $AGENT_API_TOKEN).
ENABLE_AGENTBASE=1

# Auth is a developer "Application" (OAuth2 client_credentials) — NOT a static
# token. Create an Application in AgentBase Studio, then copy its clientId /
# clientSecret / tokenUrl from the Application's credentials panel (the secret
# is shown once). The web app mints its own short-lived (~30 min RS256 JWT)
# access token from AGENTBASE_TOKEN_URL and refreshes it automatically —
# never paste a copied/static token here.
AGENTBASE_CLIENT_ID=
AGENTBASE_CLIENT_SECRET=
AGENTBASE_TOKEN_URL=https://keycloak.example.com/realms/agentbase/protocol/openid-connect/token

# Your Application must be SUBSCRIBED to each agent's registry listing before
# it can call it — even your own imported agent, same as an external consumer.
# Subscribe from the agent's listing page in AgentBase Studio.

# One env var per Mastra agent, holding its FULL AgentBase invocation URL — copy
# the "Invocation Endpoint" straight from the agent's listing page in AgentBase
# Studio ("AgentBase proxy URL" panel). No slug or skill id to track separately;
# this URL already encodes the org + agent and routes purely by that path.
# Var name = AGENTBASE_AGENT_URL_<AGENT_ID> (uppercase, non-alphanumeric → _).
# Add one line per agent as you register more of them.
AGENTBASE_AGENT_URL_EXAMPLE_AGENT=https://agentbase.example.com/proxy/a2a/your-org/example-agent-REPLACE

# ── AgentBase LLM gateway (org-admin picks the model per imported agent) ──────
# Lets an org admin choose which onboarded model (and key) each imported agent
# uses from AgentBase Studio's "LLM configuration" card — NOT from this file.
# AgentBase injects these into the running container ONLY once an admin has
# actually set a model for a given agent there; they are absent locally, in
# Standalone/External deployment mode, and for a freshly-imported agent that
# hasn't been configured yet. Leave these unset in your own .env — they exist
# here only so packages/shared/src/env.ts and apps/agents/src/mastra/lib/
# agentbase-model.ts document the contract. See docs/INTEGRATION_AGENTBASE.md.
#   AGENTBASE_HOSTED='1'                          marks an AgentBase-hosted container
#   AGENTBASE_LLM_BASE_URL                        shared gateway base URL
#   AGENTBASE_LLM_TOKEN_URL                       shared Keycloak token endpoint
#   AGENTBASE_LLM_CLIENT_ID_<AGENT_ID>             this agent's own service Application
#   AGENTBASE_LLM_CLIENT_SECRET_<AGENT_ID>
#   AGENTBASE_LLM_MODEL_<AGENT_ID>                 "<provider>/<model>", admin-chosen
# Off AgentBase (here, locally, Standalone/External), an agent falls back to
# resolveDefaultModel() (see the LLM provider section above) — no single
# provider key is required.
# ON AgentBase (AGENTBASE_HOSTED=1), an agent with no model set does NOT fall
# back to an env key — it fails at call time until the org admin picks a model
# in Studio's "LLM configuration" card. The model is set per agent there.

# ── Mastra API auth ────────────────────────────────────────────────────────────
# Static bearer token protecting the agent API routes (/api/a2a/* and
# /api/agents/*). Clients interact with the agents over the A2A protocol
# (JSON-RPC 2.0) by sending:
#     Authorization: Bearer <AGENT_API_TOKEN>
# The bearer value MUST match this variable. AgentBase injects it when proxying;
# external A2A clients can call the agents directly with it. Off when unset —
# no auth (open for local dev). Studio (/) and agent-card discovery stay open.
AGENT_API_TOKEN=

# ── Logging ──────────────────────────────────────────────────────────────────
# Verbosity for both apps' terminals (agents = Mastra's pino; web = the shared
# @precast/shared logger). One of: fatal · error · warn · info · debug · trace.
# `info` shows info/warn/error; `debug`/`trace` add the detailed firehose
# (every A2A/tool/request). In dev the output is pretty-printed + colorized.
# Tip: `pnpm dev:verbose` (or dev:agents:verbose / dev:web:verbose) forces debug
# without editing this file.
LOG_LEVEL=info