{
  "name": "@precast/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @precast/shared --filter @precast/a2ui build && dotenv -v MASTRA_TELEMETRY_DISABLED=1 -e ../../.env -- mastra dev",
    "dev:verbose": "pnpm --filter @precast/shared --filter @precast/a2ui build && dotenv -v LOG_LEVEL=debug -v MASTRA_TELEMETRY_DISABLED=1 -e ../../.env -- mastra dev",
    "build": "dotenv -v MASTRA_TELEMETRY_DISABLED=1 -- mastra build && pnpm run build:telemetry",
    "build:telemetry": "esbuild src/mastra/telemetry/preload.ts --bundle --platform=node --format=esm --target=node24 --packages=external --log-level=warning --outfile=.mastra/output/telemetry.mjs",
    "start": "dotenv -v MASTRA_TELEMETRY_DISABLED=1 -e ../../.env -- mastra start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .mastra dist"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.14",
    "@ai-sdk/openai-compatible": "3.0.63",
    "@ai-sdk/provider": "4.0.22",
    "@mastra/core": "^1.79.0",
    "@mastra/loggers": "^1.3.9",
    "@mastra/mcp": "^2.5.0",
    "@mastra/memory": "^1.39.0",
    "@mastra/pg": "^1.32.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@precast/a2ui": "workspace:^",
    "@precast/shared": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mastra/deployer": "^1.79.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "hono": "4.13.3",
    "mastra": "^1.35.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
