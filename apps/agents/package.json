{
  "name": "@precast/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @precast/shared build && dotenv -e ../../.env -- mastra dev",
    "dev:verbose": "pnpm --filter @precast/shared build && dotenv -v LOG_LEVEL=debug -e ../../.env -- mastra dev",
    "build": "mastra build",
    "start": "dotenv -e ../../.env -- mastra start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .mastra dist"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.14",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ai-sdk/provider": "^4.0.3",
    "@mastra/core": "^1.57.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/mcp": "^1.16.0",
    "@mastra/memory": "^1.26.0",
    "@mastra/pg": "^1.19.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@precast/shared": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "mastra": "^1.23.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
