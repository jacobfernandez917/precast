# ─── Local Overrides (template) ─────────────────────────────────────────────
# Copy this file to `docker-compose.override.yml` (same directory) to use it:
#   cp docker-compose.override.yml.example docker-compose.override.yml
# Compose auto-merges docker-compose.override.yml on top of docker-compose.yml.
# The real override is gitignored — add local-only tweaks (volume paths, extra
# services) there, not here. Never put secrets in it.

# Published host ports: prefer the env vars — set AGENTS_HOST_PORT / WEB_HOST_PORT
# in the root .env (e.g. 60000 / 60001). No override file needed for that.

# App (container) ports: use `pnpm set-ports` (it rewrites the base compose +
# config + scripts together) — don't edit them here.

# Use this override for anything the env vars don't cover, e.g. an extra local
# volume mount:
# services:
#   web:
#     volumes:
#       - ./local-cache:/app/.cache
